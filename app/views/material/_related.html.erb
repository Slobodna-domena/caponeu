<% if record.materials.any? %>
  <section class="section-header">
    <% if record.class == ThematicCollection %>
      <h2>Containing these materials</h2>
    <% elsif record.try(:name) == "Platform" %>
      <h2>Materials</h2>
    <% else %>
      <h2>Materials</h2>
    <% end %>
    <% if record.try(:name) == "Platform" %>
      <%= link_to "See all Materials", cdp_materials_path %>
    <% end %>
  </section>
  <section class="cards-default materials">
    <% record.materials.each do |material| %>
      <%= render "material/card", material: material %>
    <% end %>
  </section>
<% end %>
