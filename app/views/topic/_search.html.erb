<%= form_tag path, class: "map-search" do %>
  <input type="hidden" name="order" value="<%= params[:order] %>"/>
  <div>
    <label>Title</label>
    <input type="text" name="title" value="<%= params[:title] %>" placeholder="All titles"/>
  </div>
  <button class="btn filled search" type="submit">Search</button>
<% end %>
