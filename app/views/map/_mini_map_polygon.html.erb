<h4><%= JSON.parse(place)['name'] %></h4>

<div id="map_<%= JSON.parse(place)['title'] %>" style="width: 100%; height: 100%;"></div>
<script>
  function initPolyMap_<%= JSON.parse(place)['title'] %>() {

    <%= render "map/map_styles" %>
    
    // Parse the location data
    const location = JSON.parse('<%= raw place.gsub("'", "\\\\'") %>');
    
    const center = { 
      lat: parseFloat(location.lat), 
      lng: parseFloat(location.lng) 
    };
    
    // Initialize the map
    const mapElement = document.getElementById("map_" + location.title);
    if (!mapElement) { return; }
    
    const map = new google.maps.Map(mapElement, {
      zoom: 6,
      center: center,
      streetViewControl: false,
      mapTypeControlOptions: {
        mapTypeIds: []
      }
    });
    map.mapTypes.set("caponeu", styledMapType);
    map.setMapTypeId("caponeu");

    function addPolygonsToMap(map, polygonData) {
      
      if (!polygonData || !Array.isArray(polygonData)) {
        return;
      }

      const bounds = new google.maps.LatLngBounds();

      // Group coordinates into separate polygons when there's a large gap
      const polygons = [];
      let currentPolygon = [];
      const GAP_THRESHOLD = 0.5; // degrees, adjust when needed, based on data

      polygonData.forEach((coord, i) => {
        if (i > 0) {
          const prev = polygonData[i - 1];
          const distance = Math.sqrt(
            Math.pow(coord.lat - prev.lat, 2) + 
            Math.pow(coord.lng - prev.lng, 2)
          );
          
          if (distance > GAP_THRESHOLD && currentPolygon.length > 0) {
            // Large gap detected, start a new polygon
            if (currentPolygon.length >= 3) {
              polygons.push([...currentPolygon]);
            }
            currentPolygon = [];
          }
        }
        currentPolygon.push(coord);
      });

      // Add the last polygon
      if (currentPolygon.length >= 3) {
        polygons.push([...currentPolygon]);
      }

      // Create a polygon for each group of coordinates
      polygons.forEach((coords, index) => {
        try {
          
          const polygon = new google.maps.Polygon({
            paths: coords,
            strokeColor: '#FF0000',
            strokeOpacity: 0.8,
            strokeWeight: 2,
            fillColor: '#FF0000',
            fillOpacity: 0.35,
            map: map
          });

          
          // Extend bounds for each point in the polygon
          coords.forEach(p => bounds.extend(p));
          
        } catch (e) {
          console.error(`Error creating polygon ${index + 1}:`, e);
        }
      });
      
      if (!bounds.isEmpty()) {
        map.fitBounds(bounds);
      }
    }
    
    // Call the function with the parsed polygon data
    if (location.polygon && location.polygon.length > 0) {
      
      addPolygonsToMap(map, location.polygon);
    } else {
      console.error('No polygon data found');
    }
    
  }

</script>