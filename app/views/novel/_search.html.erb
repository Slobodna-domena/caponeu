<%= form_tag path, method: :get, class: "map-search" do %>
  <input type="hidden" name="order" value="<%= params[:order] %>"/>
  <div>
    <label>Title</label>
    <input type="text" name="title" value="<%= params[:title] %>" placeholder="All titles"/>
  </div>
  <div>
    <label>Author</label>
    <input type="text" name="author" value="<%= params[:author] %>" placeholder="All authors"/>
  </div>
  <div>
    <label>Portrait author</label>
    <input type="text" name="portrait_author" value="<%= params[:portrait_author] %>" placeholder="All portrait authors"/>
  </div>
  <div>
    <label>Year of publication</label>
    <div class="row">
      <input type="number" name="from_year" value="<%= params[:from_year] %>" placeholder="from"/>
      <span>-</span>
      <input type="number" name="to_year" value="<%= params[:to_year] %>" placeholder="to"/>
    </div>
  </div>
  <div>
    <label>Related people or characters</label>
    <input type="text" name="name" value="<%= params[:name] %>" placeholder="All people"/>
  </div>
  <div>
    <label>Related organizations</label>
    <input type="text" name="organization" value="<%= params[:organization] %>" placeholder="All organizations"/>
  </div>
  <div>
    <label>Topic</label>
    <%= select_tag :topic, options_from_collection_for_select(@keywords, "id", "label", params[:topic]), prompt: "All topics" %>
  </div>
  <div>
    <label>Language</label>
    <%= select_tag :language, options_from_collection_for_select(@languages, "id", "label", params[:language]), prompt: "All languages" %>
  </div>
  <div>
    <label>Category</label>
    <%= select_tag :category, options_from_collection_for_select(@categories, "id", "label", params[:category]), prompt: "All categories" %>
  </div>
  <div>
    <label>Censorship status</label>
    <select name="censorship_status">
      <option value="">All statuses</option>
      <% ["Not censored", "Censored before publication", "Censored after publication", "Published in censored form"].each do |status| %>
        <option value="<%= status %>" <%= status == params[:censorship_status] ? "selected" : "" %>> <%= status %></option>
        <% end %>
      </select>
    </div>
    <button class="btn filled search" type="submit">Search</button>
  <% end %>
