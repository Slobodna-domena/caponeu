<section class="breadcrumbs">
  <a href="<%= cdp_home_path() %>">Caponeu digital platform</a>
  <span>Events</span>
</section>
<section class="section-header margin-top-sm">
  <h1 class="orange">Events</h1>
</section>
<main class="display-all no-margin-bottom">
  <div class="sort-header col-8">
    <div class="sort-container">
      <% if @events.any? %>
        <span>Sort by:</span>
        <div class="sort">
          <div>Selection</div>
          <ul>
            <li><%= link_to "Start date", cdp_event_url %></li>
            <li><%= link_to "Name (Ascending)", cdp_event_url(order: "name_asc") %></li>
            <li><%= link_to "Name (Descending)", cdp_event_url(order: "name_desc") %></li>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
  <button class="btn text advanced-search">Advanced search</button>
  <aside class="advanced-search-container col-4">
    <h3>Advanced search</h3>
    <button class="close-icon" type="button"></button>
    <%= render 'event/search', path: cdp_event_path %>
  </aside>
  <section class="cards-default events col-8">
    <% @events.each do |event| %>
      <%= render "card" , event: event %>
    <% end %>
  </section>
  <% unless params[:all] %>
    <section class="pagination-container with-show-all">
      <div class="col-2"></div>
      <div class="col-8">
        <%= paginate @events %>
      </div>
      <div class="col-2">
        <%= link_to "Show&nbsp;all".html_safe, url_for(all: "1"), class: "btn filled", rel: "nofollow" if @events.total_pages > 1 %>
      </div>
    </section>
  <% end %>
</main>
